# Copy this to .env and fill in your values

# Database — defaults to SQLite for local dev; swap to Postgres for production
DATABASE_URL=sqlite:///./ergocare.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ergocare

# Directory where audio uploads are stored
AUDIO_UPLOAD_DIR=./uploads/audio

# Optional: OpenAI API key for Whisper transcription
# OPENAI_API_KEY=sk-...

# ── Audio upload limits ───────────────────────────────────────────────────────
MAX_AUDIO_MB=10       # Maximum size per audio clip in MB (default: 10)
MIN_FREE_MB=500       # Minimum free disk space required to accept uploads (default: 500)
AUDIO_UPLOAD_DIR=./uploads/audio
